{
  "configVersion": "v3",
  "app": {
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "appId": 10524117,
    "appName": "SP Watch",
    "vender": "AntonioMancebo",
    "description": "Super Productivity tasks on Amazfit Cheetah 2 Ultra"
  },
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": ["page/home/index.page"]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "i18n": {
    "en-US": { "name": "SP Watch" },
    "es-ES": { "name": "SP Watch" }
  },
  "defaultLanguage": "es-ES",
  "debug": true
}
